# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# Google Cloud Platform (Service Account & Project)
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account.json
GCP_PROJECT_ID=your_gcp_project_id
DOC_AI_PROCESSOR_ID=your_doc_ai_processor_id
GCP_STORAGE_BUCKET_NAME=your_gcs_bucket_name
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets
GOOGLE_SHEET_ID=your_google_sheet_id_here

# LINE Login / LIFF (used to build the review-form link and verify ID tokens)
LIFF_ID=your_liff_id_here
LINE_LOGIN_CHANNEL_ID=your_line_login_channel_id_here

# Cloud Tasks (offloads Document AI + Gemini processing off the webhook thread)
CLOUD_TASKS_LOCATION=asia-southeast1
CLOUD_TASKS_QUEUE=process-image-queue
PUBLIC_BASE_URL=https://your-deployed-service-url
INTERNAL_TASK_SECRET=a_long_random_shared_secret

# App Config
PORT=8080
WHITELISTED_LINE_USER_IDS=USER_ID_1,USER_ID_2,USER_ID_3
